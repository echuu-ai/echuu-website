{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "^/website/((?:zh|en|ja|ko)(?:/[^.]*[^/.])?)$",
      "status": 308,
      "headers": { "Location": "/website/$1/" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/website/?$",
      "dest": "/website/index.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
