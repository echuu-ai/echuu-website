# Never put private credentials in VITE_* variables.
# Confirmed future domain. Enable indexing only for the migrated public deployment.
VITE_SITE_ORIGIN=https://www.echuu.ai
VITE_SITE_INDEXABLE=0
# Google Analytics 4 measurement ID (G-XXXXXXX). Loads only on the production origin.
VITE_GA_MEASUREMENT_ID=
# Optional feedback endpoint; beta registration uses the platform proxy below.
VITE_FEEDBACK_ENDPOINT=

# Separate product application used by the Sign up button.
VITE_PRODUCT_ORIGIN=https://echuu.live

# Invite-code redemption. Point at the built-in serverless function (same origin,
# no CORS). Blank values use the same built-in proxy.
VITE_INVITE_REDEEM_ENDPOINT=/api/redeem
VITE_BETA_ACCOUNT_ENDPOINT=
# For local integration set VITE_PRODUCT_ORIGIN=http://localhost:5173
# Never put invitation allowlists, SMTP credentials or mail API keys in VITE_*.

# --- /api/redeem server-side config (NO VITE_ prefix; set in Vercel, never shipped to the browser) ---
# Platform API and dedicated website key (must match the backend).
BETA_PLATFORM_API_BASE=https://api.echuu.live/api/v1
BETA_WEBSITE_API_KEY=
# Welcome email delivery is configured on the platform, not this website.

# Optional anonymous JSON endpoint returning only { count, updatedAt }.
VITE_BETA_COUNT_ENDPOINT=
